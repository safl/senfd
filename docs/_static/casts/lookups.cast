g Check\u001b[0m        \u001b[36m \u001b[0m\u001b[1mSTC\u001b[0m    \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m23:20 \u001b[36m \u001b[0mDirective Type           \u001b[36m \u001b[0mDTYPE  \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m19:16 \u001b[36m \u001b[0mCommand Extension Type   \u001b[36m \u001b[0mCETYPE \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m15:00 \u001b[36m \u001b[0mNumber of Logical Blocks \u001b[36m \u001b[0mNLB    \u001b[36m \u001b[0m\r\n\u001b[36m                                          \u001b[0m\r\n\r\n\u001b[35m\u258c \u001b[0m\u001b[1;35mSTC\u001b[0m\u001b[35m, Storage Tag Check, is bit 24 of\u001b[0m\u001b[35m                                                                      \u001b[0m\r\n"]
