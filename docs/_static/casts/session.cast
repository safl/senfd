[33.48, "o", "\u001b[?25l\u001b[?7l\u001b[35D\u001b[0m\u001b[J\u001b[0msate> what does \u001b[0;33;1mstatus\u001b[0m 0x4281 mean?\u001b[35D\u001b[0m\r\r\n\u001b[J\u001b[?7h\u001b[0m\u001b[?12l\u001b[?25h\u001b[?2004l\u001b[1mwhat does status \u001b[0m\u001b[1;36m0x4281\u001b[0m\u001b[1m mean?\u001b[0m \u001b[92m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n\u001b[36mread as status('4281h')\u001b[0m\u001b[2;36m | \u001b[0m\u001b[2;32m1 lookup\u001b[0m\u001b[2;36m | \u001b[0m\u001b[2;32m2.9 ms\u001b[0m\u001b[2;36m | \u001b[0m\u001b[2;32mcites 3 figures\u001b[0m\r\n\r\n\u001b[1m \u2022 \u001b[0mStatus 4281h of a completion: DNR 1 (Do Not Retry), M 0, CRD 0h, SCT 2h, SC 81h \u001b]8;id=6868174;https://nvmexpress.org/wp-content/uploads/NVM-Express-Base-Specification-Revision-2.4-Ratified-2026.07.31.pdf#page=171\u001b\\\u001b[4;34mBase 2.4, 4.2.3, Figure \u001b[0m\u001b]8;;\u001b\\   \r\n\u001b[1m   \u001b[0m\u001b]8;id=6868174;https://nvmexpress.org/wp-content/uploads/NVM-Express-Base-Specification-Revision-2.4-Ratified-2026.07.31.pdf#page=171\u001b\\\u001b[4;34m101, page 145, PDF page 171\u001b[0m\u001b]8;;\u001b\\                                                                                \r\n\u001b[1m \u2022 \u001b[0mSCT 2h Media and Data Integrity Errors \u001b]8;id=6868175;https://nvmexpress.org/wp-content/uploads/NVM-Express-Base-Specification-Revision-2.4-Ratified-2026.07.31.pdf#page=172\u001b\\\u001b[4;34mBase 2.4, 4.2.3, Figure 102, page 146, PDF page 172\u001b[0m\u001b]8;;\u001b\\                 \r\n\u001b[1m \u2022 \u001b[0m\u001b[1mSC 81h\u001b[0m Unrecovered Read Error, Media and Data Integrity Error status code \u001b]8;id=6868176;https://nvmexpress.org/wp-content/uploads/NVM-Express-Base-Specification-Revision-2.4-Ratified-2026.07.31.pdf#page=180\u001b\\\u001b[4;34mBase 2.4, 4.2.3.3, Figure 107, \u001b[0m\u001b]8;;\u001b\\  \r\n\u001b[1m   \u001b[0m\u001b]8;id=6868176;https://nvmexpress.org/wp-content/uploads/NVM-Express-Base-Specification-Revision-2.4-Ratified-2026.07.31.pdf#page=180\u001b\\\u001b[4;34mpage 154, PDF page 180\u001b[0m\u001b]8;;\u001b\\                                                                                     \r\n\u001b[6n\u001b[?2004h\u001b[?25l\u001b[0m\u001b[?7l\u001b[0m\u001b[J\u001b[0msate>\u001b[0m\r\r\n\r\r\n\r\r\n\r\r\n\r\r\n\r\r\n\r\r\n\u001b[0m \b\u001b[7A\u001b[6C\u001b[?7h\u001b[0m\u001b[?12l\u001b[?25h\u001b[?25l\u001b[?7l\u001b[0m\r\r\n\r\r\n\r\r\n\r\r\n\r\r\n\r\r\n\r\r\n\r\r\n\u001b[0;97;40;1m Ask of 100 commands, 51 features, 59 log pages, 596 structures\u001b[0;97;40m                                              \r\u001b[109C \u001b[0m\r\r\n\u001b[0;90;40m ? questions | Up, Down history | F1 forms | Ctrl-D leave\u001b[0;97;40m                                                    \r\u001b[109C \r\u001b[9A\u001b[6C\u001b[?7h\u001b[0m\u001b[?12l\u001b[?25h"]
