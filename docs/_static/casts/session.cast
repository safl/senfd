[0.5, "o", "\u001b[1msate \u001b[0m\u001b[1;36m0.13\u001b[0m\u001b[1m.\u001b[0m\u001b[1;36m0\u001b[0m  \u001b[1;36m100\u001b[0m commands, \u001b[1;36m51\u001b[0m features, \u001b[1;36m59\u001b[0m log pages, \u001b[1;36m592\u001b[0m structures\r\n\u001b[2m~\u001b[0m\u001b[2;35m/.cache/senfd/\u001b[0m\u001b[2;95mmerged.spec.document.json\u001b[0m\r\n\u001b[1mAsk about a command, a feature, a log page, a structure, a register or a field.\u001b[0m                               \r\n\r\n\u001b[36m                                                                                                              \u001b[0m\r\n\u001b[36m \u001b[0m\u001b[36mAsk\u001b[0m\u001b[1m                               \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mAs\u001b[0m\u001b[1m                                                                      \u001b[0m\u001b[36m \u001b[0m\r\n\u001b[36m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[0m\r\n\u001b[36m \u001b[0ma command, with its dwords         \u001b[36m \u001b[0m\u001b[1;36;40mwrite\u001b[0m, \u001b[1;36;40mzone append\u001b[0m                                                      \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0ma command's opcode alone           \u001b[36m \u001b[0m\u001b[1;36;40mopcode of sanitize\u001b[0m                                                      \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0mone dword of a command             \u001b[36m \u001b[0m\u001b[1;36;40mcdw12 of write\u001b[0m, \u001b[1;36;40mdword 10 of get log page\u001b[0m                                \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0ma feature or a log page            \u001b[36m \u001b[0m\u001b[1;36;40mfeature 07h\u001b[0m, \u001b[1;36;40mfeature number of queues\u001b[0m, \u001b[1;36;40mlog page 1Fh\u001b[0m                     \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0mwhat an identifier is              \u001b[36m \u001b[0m\u001b[1;36;40m1Fh\u001b[0m                                                                     \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0ma status code or a CNS value       \u001b[36m \u001b[0m\u001b[1;36;40mstatus code 82h\u001b[0m, \u001b[1;36;40mstatus code type 1h\u001b[0m, \u001b[1;36;40mCNS 05h\u001b[0m, \u001b[1;36;40mstatus code of zone \u001b[0m     \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m                                   \u001b[36m \u001b[0m\u001b[1;36;40mboundary error\u001b[0m                                                          \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0ma structure or a register          \u001b[36m \u001b[0m\u001b[1;36;40mstructure identify controller\u001b[0m, \u001b[1;36;40mCC\u001b[0m, \u001b[1;36;40mCSTS\u001b[0m                                 \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0ma field, everywhere it is          \u001b[36m \u001b[0m\u001b[1;36;40mFUA\u001b[0m, \u001b[1;36;40msearch storage tag\u001b[0m                                                 \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0many of these with the descriptions \u001b[36m \u001b[0m\u001b[1;36;40mdescribe cdw12 of write\u001b[0m, \u001b[1;36;40mexplain CSTS\u001b[0m                                   \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0ma section                          \u001b[36m \u001b[0m\u001b[1;36;40msection 5.2.6\u001b[0m                                                           \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0mwhat the documents may have wrong  \u001b[36m \u001b[0m\u001b[1;36;40merrata\u001b[0m, \u001b[1;36;40merrata nvm\u001b[0m                                                      \u001b[36m \u001b[0m\r\n\u001b[36m                                                                                                              \u001b[0m\r\n\r\nTab completes a name or an acronym, \u001b[1;36;40m?\u001b[0m shows the questions to ask, \u001b[1;36;40mhelp\u001b[0m or F1 this, and Ctrl-D leaves.         \r\n\u001b[?12l\u001b[?25h\u001b[6n\u001b[?2004h\u001b[?1l\u001b[?25l\u001b[0m\u001b[?7l\u001b[0m\u001b[J\u001b[0msate>\u001b[0m\r\r\n\r\r\n\r\r\n\r\r\n\r\r\n\r\r\n\r\r\n\u001b[0m \b\u001b[7A\u001b[6C\u001b[?7h\u001b[0m\u001b[?12l\u001b[?25h\u001b[?25l\u001b[?7l\u001b[0m\r\r\n\u001b[6C\u001b[0;38;5;16;48;5;250m what is the opcode of <command>?                 \u001b[0;38;5;16;48;5;246m question \u001b[0;38;5;16;48;5;238m \u001b[0m\r\r\n\u001b[6C\u001b[0;38;5;16;48;5;250m which bit of cdw<N> of <command> is <acronym>?   \u001b[0;38;5;16;48;5;246m question \u001b[0;38;5;16;48;5;238m \u001b[0m\r\r\n\u001b[6C\u001b[0;38;5;16;48;5;250m which bits of cdw<N> of <command> are <acronym>? \u001b[0;38;5;16;48;5;246m question \u001b[0;38;5;16;48;5;238m \u001b[0m\r\r\n\u001b[6C\u001b[0;38;5;16;48;5;250m what are the fields of the <structure>?          \u001b[0;38;5;16;48;5;246m question \u001b[0;38;5;16;48;5;248m \u001b[0m\r\r\n\u001b[6C\u001b[0;38;5;16;48;5;250m which feature is <name or identifier>?           \u001b[0;38;5;16;48;5;246m question \u001b[0;38;5;16;48;5;248m \u001b[0m\r\r\n\u001b[6C\u001b[0;38;5;16;48;5;250m which log page is <name or identifier>?          \u001b[0;38;5;16;48;5;246m question \u001b[0;38;5;16;48;5;248m \u001b[0m\r\r\n\u001b[6C\u001b[0;38;5;16;48;5;250m what is status code <value or name>?             \u001b[0;38;5;16;48;5;246m question \u001b[0;38;5;16;48;5;248m \u001b[0m\r\r\n\u001b[0;97;40;1m Ask of 100 commands, 51 features, 59 log pages, 592 structures\u001b[0;97;40m         