[38.17, "o", "\u001b[3mUnderstood as \u001b[0m\u001b[1;3;36;40mregister('CSTS')\u001b[0m                                                                                \r\n\r\n\u001b[1mCSTS - Controller Status at offset 1Ch, bits \u001b[0m\u001b]8;id=8461314;https://nvmexpress.org/wp-content/uploads/NVM-Express-Base-Specification-Revision-2.4-Ratified-2026.07.31.pdf#page=89\u001b\\\u001b[1;4;34mBase 2.4, 3.1.4.6, Figure 42, page 63, PDF page 89\u001b[0m\u001b]8;;\u001b\\               \r\n\r\n\u001b[36m                                              \u001b[0m\r\n\u001b[36m \u001b[0m\u001b[36mBits\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mName\u001b[0m\u001b[1m                        \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mAcronym\u001b[0m\u001b[36m \u001b[0m\r\n\u001b[36m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[0m\r\n\u001b[36m \u001b[0m31:07 \u001b[36m \u001b[0mReserved                     \u001b[36m \u001b[0m       \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m\u001b[1m06\u001b[0m    \u001b[36m \u001b[0m\u001b[1mShutdown Type\u001b[0m                \u001b[36m \u001b[0m\u001b[1mST\u001b[0m     \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m05    \u001b[36m \u001b[0mProcessing Paused            \u001b[36m \u001b[0mPP     \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m04    \u001b[36m \u001b[0mNVM Subsystem Reset Occurred \u001b[36m \u001b[0mNSSRO  \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m03:02 \u001b[36m \u001b[0mShutdown Status              \u001b[36m \u001b[0mSHST   \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m01    \u001b[36m \u001b[0mController Fatal Status      \u001b[36m \u001b[0mCFS    \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m00    \u001b[36m \u001b[0mReady                        \u001b[36m \u001b[0mRDY    \u001b[36m \u001b[0m\r\n\u001b[36m                                              \u001b[0m\r\n\r\n\u001b[35m\u258c \u001b[0m\u001b[1;35mST\u001b[0m\u001b[35m, Shutdown Type, is bit 06 of CSTS - Controller Status at offset 1Ch \u001b[0m\u001b]8;id=8461319;https://nvmexpress.org/wp-content/uploads/NVM-Express-Base-Specification-Revision-2.4-Ratified-2026.07.31.pdf#page=89\u001b\\\u001b[4;34mBase 2.4, 3.1.4.6, Figure 42, page \u001b[0m\u001b]8;;\u001b\\\r\n\u001b[35m\u258c \u001b[0m\u001b]8;id=8461320;https://nvmexpress.org/wp-content/uploads/NVM-Express-Base-Specification-Revision-2.4-Ratified-2026.07.31.pdf#page=89\u001b\\\u001b[4;34m63, PDF page 89\u001b[0m\u001b]8;;\u001b\\\u001b[35m                                                                                           \u001b[0m\r\n"]
