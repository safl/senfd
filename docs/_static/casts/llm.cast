[18.685, "o", "\u001b[3mUnderstood as \u001b[0m\u001b[1;3;36;40mcommand('sanitize', dword=10)\u001b[0m                                                                   \r\n\r\n\u001b[1;35mSanitize: Admin command, opcode 84h \u001b[0m\u001b]8;id=4655311;https://nvmexpress.org/wp-content/uploads/NVM-Express-Base-Specification-Revision-2.4-Ratified-2026.07.31.pdf#page=202\u001b\\\u001b[1;4;34mBase 2.4, 5, Figure 143, page 176, PDF page 202\u001b[0m\u001b]8;;\u001b\\                           \r\n\r\n\u001b[1mcdw10 \u001b[0m\u001b]8;id=4655315;https://nvmexpress.org/wp-content/uploads/NVM-Express-Base-Specification-Revision-2.4-Ratified-2026.07.31.pdf#page=476\u001b\\\u001b[1;4;34mBase 2.4, 5.2.26, Figure 451, page 448, PDF page 476\u001b[0m\u001b]8;;\u001b\\                                                    \r\n\r\n\u001b[36m                                                         \u001b[0m\r\n\u001b[36m \u001b[0m\u001b[36mBits\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mName\u001b[0m\u001b[1m                                   \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mAcronym\u001b[0m\u001b[36m \u001b[0m\r\n\u001b[36m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[0m\r\n\u001b[36m \u001b[0m31:12 \u001b[36m \u001b[0mReserved                                \u001b[36m \u001b[0m       \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m11    \u001b[36m \u001b[0mPurge Required                          \u001b[36m \u001b[0mPREQ   \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m\u001b[1m10\u001b[0m    \u001b[36m \u001b[0m\u001b[1mEnter Media Verification State\u001b[0m          \u001b[36m \u001b[0m\u001b[1mEMVS\u001b[0m   \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m09    \u001b[36m \u001b[0mNo-Deallocate After Sanitize            \u001b[36m \u001b[0mNDAS   \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m08    \u001b[36m \u001b[0mOverwrite Invert Pattern Between Passes \u001b[36m \u001b[0mOIPBP  \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m07:04 \u001b[36m \u001b[0mOverwrite Pass Count                    \u001b[36m \u001b[0mOWPASS \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m03    \u001b[36m \u001b[0mAllow Unrestricted Sanitize Exit        \u001b[36m \u001b[0mAUSE   \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m02:00 \u001b[36m \u001b[0mSanitize Action                         \u001b[36m \u001b[0mSANACT \u001b[36m \u001b[0m\r\n\u001b[36m                                                         \u001b[0m\r\n\r\n\u001b[35m\u258c \u001b[0m\u001b[1;35mEMVS\u001b[0m\u001b[35m, Enter Media Verification State, is bit 10 of cdw10 of Sanitize \u001b[0m\u001b]8;id=4655320;https://nvmexpress.org/wp-content/uploads/NVM-Express-Base-Specification-Revision-2.4-Ratified-2026.07.31.pdf#page=476\u001b\\\u001b[4;34mBase 2.4, 5.2.26, Figure 451, page \u001b[0m\u001b]8;;\u001b\\\u001b[35m  \u001b[0m\r\n\u001b[35m\u258c \u001b[0m\u001b]8;id=4655321;https://nvmexpress.org/wp-content/uploads/NVM-Express-Base-Specification-Revision-2.4-Ratified-2026.07.31.pdf#page=476\u001b\\\u001b[4;34m448, PDF page 476\u001b[0m\u001b]8;;\u001b\\\u001b[35m                                                                                         \u001b[0m\r\n"]
