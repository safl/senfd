{
    "$defs": {
        "Bits": {
            "description": "A field of bits or bytes; 'upper' and 'lower' are None where the document\ngives the range by a formula, which 'range' then holds",
            "properties": {
                "name": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Name"
                },
                "acronym": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Acronym"
                },
                "unit": {
                    "title": "Unit",
                    "type": "string"
                },
                "upper": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Upper"
                },
                "lower": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Lower"
                },
                "range": {
                    "title": "Range",
                    "type": "string"
                },
                "description": {
                    "default": "",
                    "title": "Description",
                    "type": "string"
                },
                "section": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Section"
                },
                "columns": {
                    "additionalProperties": {
                        "type": "string"
                    },
                    "title": "Columns",
                    "type": "object"
                },
                "fields": {
                    "items": {
                        "$ref": "#/$defs/Bits"
                    },
                    "title": "Fields",
                    "type": "array"
                }
            },
            "required": [
                "unit",
                "range"
            ],
            "title": "Bits",
            "type": "object"
        },
        "Command": {
            "properties": {
                "name": {
                    "title": "Name",
                    "type": "string"
                },
                "opcode": {
                    "title": "Opcode",
