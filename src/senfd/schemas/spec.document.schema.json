        "Diagnostic": {
            "description": "Something about a figure that senfd normalised, or could not make sense of\n\nA 'note' is a variant senfd normalised; nothing is lost. A 'warning' is\nsomething left out of the output, as a row whose range is not a range.",
            "properties": {
                "figure_nr": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Figure Nr"
                },
                "severity": {
                    "title": "Severity",
                    "type": "string"
                },
                "code": {
                    "title": "Code",
                    "type": "string"
                },
                "message": {
                    "title": "Message",
                    "type": "string"
                }
            },
            "required": [
                "severity",
                "code",
                "message"
            ],
            "title": "Diagnostic",
            "type": "object"
        },
        "DocumentMeta": {
            "properties": {
                "version": {
                    "default": "0.4.0",
